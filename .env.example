# Variáveis de ambiente da Carchuna — apenas os NOMES.
# Copie para `.env` (que está no .gitignore) e preencha localmente.
# Nenhum valor real entra neste arquivo, nem truncado.

# Credencial da API do modelo de linguagem. Só é usada quando
# CARCHUNA_USAR_LLM=1; sem ela a Carchuna funciona inteira em modo
# extrativo, e /api/v1/saude diz em português por que a narrativa não
# está saindo.
ANTHROPIC_API_KEY=

# Alternativa à anterior, para quem usa token em vez de chave.
ANTHROPIC_AUTH_TOKEN=

# Liga a narrativa em linguagem natural. Desligada de fábrica porque
# cada pergunta vira uma chamada paga.
CARCHUNA_USAR_LLM=

# Modelo usado quando a narrativa está ligada. Vazio usa o padrão.
CARCHUNA_MODEL=

# Liga o campo que lê um arquivo por caminho do disco. Desligado de
# fábrica: no dashboard publicado ele leria o disco do servidor, e o
# recurso só faz sentido com a Carchuna rodando na sua máquina.
CARCHUNA_LER_CAMINHO=

# Quantos proxies reversos da SUA infraestrutura ficam na frente da API.
# Vazio ou 0 ignora o cabeçalho X-Forwarded-For, que é o certo sem proxy:
# o cabeçalho é texto que o cliente manda, e confiar nele por padrão
# entrega o limite de chamadas a quem ele deveria limitar.
CARCHUNA_PROXIES_CONFIAVEIS=
